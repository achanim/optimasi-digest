{
  "name": "optimasi-digest",
  "version": "1.0.4",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external pdfmake",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "@types/pdfmake": "^0.3.2",
    "pdfmake": "^0.2.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.x",
    "typescript": "^5.x"
  },
  "peerDependencies": {
    "pdfmake": ">=0.2.0",
    "typescript": ">=5.0"
  }
}
